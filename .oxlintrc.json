{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node"],
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // Fights `noUncheckedIndexedAccess`: every `bytes[i] as number` after an index read is
    // reported as an unsafe narrowing, when it is the pattern that setting demands.
    "typescript/no-unsafe-type-assertion": "off",
    // Its premise is false for typed arrays. `Uint8Array.prototype.slice` returns a Uint8Array,
    // so `[...bytes.slice(a, b)]` is a conversion to a plain array, not a redundant copy — and
    // its auto-fix silently removed one, turning a passing assertion into a failing one.
    "unicorn/no-useless-spread": "off",
    // TypeScript 5.0 cannot parse this source or read current library types, and the compiler API
    // reports that as diagnostics a tool rarely reads, so a script on it walks damaged trees.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "typescript-floor",
            "message": "typescript-floor is TypeScript 5.0, kept only to compile packed consumers on the oldest supported compiler. It cannot parse this source (import attributes) or read current library types (Uint8Array<ArrayBuffer>), so a tool built on it silently reads damaged trees. Import typescript-checker, the last in-process TypeScript, instead."
          }
        ],
        "patterns": [
          {
            "group": ["typescript-floor/**", "**/typescript-floor/**"],
            "message": "Subpaths of typescript-floor (TypeScript 5.0) are restricted for the same reason as the package: import typescript-checker instead."
          }
        ]
      }
    ]
  },
  // Benchmark runtimes run serially to avoid contention; scripts also contain ordered I/O.
  "overrides": [
    {
      "files": ["bench/**", "scripts/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    // Catch direct Node imports here; the artifact check also catches transitive imports.
    {
      "files": ["src/runtime/web.ts"],
      "rules": {
        "import/no-nodejs-modules": "error"
      }
    }
  ],
  "ignorePatterns": ["dist", "bench/reports"]
}
