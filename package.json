{
  "name": "@anizoptera/uuid-slug",
  "version": "0.4.1-dev",
  "description": "Zero-dependency UUIDv4/v7 generation, lossless base64url and base32hex slugs for any UUID, and reversible UUIDv7 masking for databases, URLs, and files.",
  "keywords": [
    "base32hex",
    "base64url",
    "browser",
    "bun",
    "deno",
    "identifier",
    "node",
    "short-uuid",
    "slug",
    "typescript",
    "url-safe",
    "uuid",
    "uuidv4",
    "uuidv7",
    "zero-dependencies"
  ],
  "homepage": "https://github.com/Anizoptera/uuid-slug#readme",
  "bugs": {
    "url": "https://github.com/Anizoptera/uuid-slug/issues"
  },
  "license": "Apache-2.0",
  "author": "Anizoptera",
  "contributors": [
    "Art Shendrik"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anizoptera/uuid-slug.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#runtime": {
      "bun": "./src/runtime/bun.ts",
      "deno": "./src/runtime/portable.ts",
      "development": {
        "node": "./src/runtime/node.ts",
        "default": "./src/runtime/portable.ts"
      },
      "node": "./dist/node/runtime.js",
      "default": "./dist/runtime/portable.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "deno": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:check": "bun scripts/api-run.ts check",
    "api:check:built": "bun scripts/api-run.ts check --built",
    "api:update": "bun scripts/api-run.ts update",
    "artifact:check": "bun scripts/check-artifact.ts",
    "bench:entropy": "bun bench/entropy.ts",
    "bench:full": "bun bench/run.ts",
    "bench:smoke": "bun bench/run.ts --smoke",
    "build": "tsdown",
    "changelog": "git-cliff --unreleased --prepend CHANGELOG.md --tag",
    "check": "bun run build && bun run --parallel api:check:built check:js:unpacked:built check:rust bench:competitors:smoke bench:competitors:rust:check && bun run artifact:check && bun run perf:check",
    "check:fast": "bun run build && bun run --parallel api:check:built check:js:unpacked:built check:rust:fast bench:competitors:smoke && bun run artifact:check",
    "check:js": "bun run build && bun run check:js:built",
    "check:js:built": "bun run check:js:unpacked:built && bun run artifact:check",
    "check:js:unpacked:built": "bun run --parallel format:check lint strings:check claude-link:check typecheck:built typecheck:bun test",
    "check:rust": "bun scripts/check-rust.ts",
    "check:rust:fast": "bun scripts/check-rust.ts --fast",
    "claude-link:check": "bun scripts/check-claude-link.ts",
    "clean": "rm -rf dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepublishOnly": "bun run publish:clean",
    "preversion": "bun run check",
    "publish:clean": "printf '%s\\n' '\n  There is no local publish. Releases are published by CI, from a pushed tag.\n\n    bun run changelog v<next>   draft the section from the commits since the last tag\n    $EDITOR CHANGELOG.md        say what a consumer gets, not what changed in the tree\n    git commit -am <msg>        the bump aborts on a dirty tree\n    bun run release <next>      runs the lane, then commits and annotates the tag\n    git push --follow-tags      .github/workflows/release.yml publishes it\n\n  Why not from here: npm refuses to sign a publish that did not come from a cloud CI\n  runner, so a laptop release is permanently unsigned. This repo also holds no npm\n  token -- release.yml authenticates over OIDC against the trusted publisher bound to\n  that workflow filename.\n\n  The tag is the release. Nothing else publishes.\n' >&2; exit 1",
    "release": "bun scripts/release.ts",
    "test": "bun run --parallel test:node test:bun",
    "test:bun": "bun scripts/test-bun.ts --parallel=2 __test__/*.bun.test.ts scripts/__test__/*.test.ts",
    "test:node": "bun scripts/test-vitest.ts",
    "typecheck": "bun run build && bun run typecheck:built",
    "typecheck:built": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "typecheck:bun": "bun --check",
    "version:set": "bun scripts/release-version.ts",
    "version": "bun scripts/release-notes.ts --sync > /dev/null && git add rust/Cargo.toml rust/Cargo.lock bench/rust-competitors/Cargo.lock",
    "bench:matrix": "bun bench/matrix.ts",
    "bench:profile": "bun bench/profile-all.ts",
    "bench:profile:native": "bun bench/profile-all.ts --native",
    "bench:compare": "bun bench/compare.ts",
    "bench:competitors": "bun scripts/generation-matrix.ts",
    "bench:competitors:audit": "bun scripts/audit-competitors.ts",
    "bench:competitors:rust": "CARGO_TARGET_DIR=rust/target/competitors cargo run --manifest-path bench/rust-competitors/Cargo.toml --release --locked",
    "bench:competitors:rust:check": "CARGO_TARGET_DIR=rust/target/competitors cargo check --manifest-path bench/rust-competitors/Cargo.toml --locked",
    "bench:competitors:smoke": "bun scripts/generation-matrix.ts --smoke",
    "bench:results": "bun bench/results.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "strings:check": "bun scripts/check-string-owners.ts",
    "artifact:web": "bun scripts/check-artifact.ts --web",
    "perf:check": "bun bench/check.ts"
  },
  "devDependencies": {
    "@anizoptera/publish-clean": "^0.10.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@kripod/uuidv7": "^0.3.4",
    "@lukeed/uuid": "2.0.1",
    "@microsoft/api-extractor": "7.59.4",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rspack/core": "2.2.8",
    "@scure/base": "2.4.0",
    "@smithy/uuid": "1.4.2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "crypto-randomuuid": "1.0.0",
    "esbuild": "0.28.2",
    "fastv7": "^1.0.2",
    "git-cliff": "^2.14.2",
    "mdast-util-from-markdown": "^2.1.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "parcel": "2.16.4",
    "playwright": "^1.64.0",
    "pnpm": "^12.11.2",
    "publint": "^0.3.25",
    "rollup": "4.64.5",
    "short-uuid": "6.0.3",
    "slugid": "5.0.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "typescript-floor": "npm:typescript@5.0.4",
    "uniku": "0.6.0",
    "uuid": "^14.0.3",
    "uuid-random": "1.3.2",
    "uuidv7": "^1.2.1",
    "uuidv7-js": "^2.0.0",
    "vitest": "^5.0.4",
    "webpack": "5.111.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publish-clean": {
    "validateArtifact": [
      "bun",
      "scripts/check-artifact.ts"
    ]
  },
  "trustedDependencies": [
    "pnpm"
  ]
}
