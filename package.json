{
  "name": "@anizoptera/uuid-slug",
  "version": "0.4.0-dev",
  "description": "Short URL-safe UUIDs, plus reversible masking that hides recognizable UUIDv7 structure. Zero dependencies.",
  "keywords": [
    "base64url",
    "browser",
    "bun",
    "deno",
    "identifier",
    "node",
    "short-uuid",
    "slug",
    "url-safe",
    "uuid",
    "uuidv7",
    "zero-dependencies"
  ],
  "homepage": "https://github.com/Anizoptera/uuid-slug#readme",
  "bugs": {
    "url": "https://github.com/Anizoptera/uuid-slug/issues"
  },
  "license": "Apache-2.0",
  "author": "Anizoptera",
  "contributors": [
    "Art Shendrik"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anizoptera/uuid-slug.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#runtime": {
      "bun": "./src/runtime/bun.ts",
      "deno": "./src/runtime/web.ts",
      "browser": "./src/runtime/web.ts",
      "node": "./src/runtime/node.ts",
      "default": "./src/runtime/web.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "node": "./dist/node/index.js",
      "default": "./dist/index.js"
    },
    "./uuid": {
      "types": "./dist/entries/uuid.d.ts",
      "bun": "./src/entries/uuid.ts",
      "development": "./src/entries/uuid.ts",
      "node": "./dist/node/entries/uuid.js",
      "default": "./dist/entries/uuid.js"
    },
    "./slug": {
      "types": "./dist/entries/slug.d.ts",
      "bun": "./src/entries/slug.ts",
      "development": "./src/entries/slug.ts",
      "node": "./dist/node/entries/slug.js",
      "default": "./dist/entries/slug.js"
    },
    "./slug/v4": {
      "types": "./dist/v4-slug.d.ts",
      "bun": "./src/v4-slug.ts",
      "development": "./src/v4-slug.ts",
      "node": "./dist/node/v4-slug.js",
      "default": "./dist/v4-slug.js"
    },
    "./slug/v7": {
      "types": "./dist/v7-slug.d.ts",
      "bun": "./src/v7-slug.ts",
      "development": "./src/v7-slug.ts",
      "node": "./dist/node/v7-slug.js",
      "default": "./dist/v7-slug.js"
    },
    "./v4": {
      "types": "./dist/entries/v4.d.ts",
      "bun": "./src/entries/v4.ts",
      "development": "./src/entries/v4.ts",
      "node": "./dist/node/entries/v4.js",
      "default": "./dist/entries/v4.js"
    },
    "./v7": {
      "types": "./dist/entries/v7.d.ts",
      "bun": "./src/entries/v7.ts",
      "development": "./src/entries/v7.ts",
      "node": "./dist/node/entries/v7.js",
      "default": "./dist/entries/v7.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:check": "bun scripts/api.ts check",
    "api:check:built": "bun scripts/api.ts check --built",
    "api:update": "bun scripts/api.ts update",
    "artifact:check": "bun scripts/check-artifact.ts",
    "bench:entropy": "bun bench/entropy.ts",
    "bench:full": "bun bench/run.ts",
    "bench:smoke": "bun bench/run.ts --smoke",
    "build": "tsdown",
    "changelog": "git-cliff --unreleased --prepend CHANGELOG.md --tag",
    "check": "bun run build && bun run --parallel api:check:built check:js:built check:rust && bun run perf:check",
    "check:fast": "bun run build && bun run --parallel api:check:built check:js:built check:rust:fast && bun run perf:check",
    "check:js": "bun run build && bun run check:js:built",
    "check:js:built": "bun run --parallel format:check lint claude-link:check typecheck:built test bench:smoke bench:competitors:smoke artifact:check",
    "check:rust": "bun scripts/check-rust.ts",
    "check:rust:fast": "bun scripts/check-rust.ts --fast",
    "claude-link:check": "bun scripts/check-claude-link.ts",
    "clean": "rm -rf dist bench/reports",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepublishOnly": "bun run publish:clean",
    "preversion": "bun run check",
    "publish:clean": "printf '%s\\n' '\n  There is no local publish. Releases are published by CI, from a pushed tag.\n\n    bun run changelog v<next>   draft the section from the commits since the last tag\n    $EDITOR CHANGELOG.md        say what a consumer gets, not what changed in the tree\n    git commit -am <msg>        the bump aborts on a dirty tree\n    bun run release <next>      runs the lane, then commits and annotates the tag\n    git push --follow-tags      .github/workflows/release.yml publishes it\n\n  Why not from here: npm refuses to sign a publish that did not come from a cloud CI\n  runner, so a laptop release is permanently unsigned. This repo also holds no npm\n  token -- release.yml authenticates over OIDC against the trusted publisher bound to\n  that workflow filename.\n\n  The tag is the release. Nothing else publishes.\n' >&2; exit 1",
    "release": "pnpm version --allow-same-version",
    "test": "bun run --parallel test:node test:bun",
    "test:bun": "bun test --parallel=2 test/*.bun.test.ts scripts/*.test.ts",
    "test:node": "vitest run",
    "typecheck": "bun run build && bun run typecheck:built",
    "typecheck:built": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "version:set": "bun scripts/release-version.ts",
    "version": "bun scripts/release-notes.ts --sync > /dev/null && git add rust/Cargo.toml rust/Cargo.lock",
    "bench:matrix": "bun bench/matrix.ts",
    "bench:profile": "bun bench/profile-all.ts",
    "bench:profile:native": "bun bench/profile-all.ts --native",
    "bench:compare": "bun bench/compare.ts",
    "bench:competitors": "bun bench/generation-matrix.ts",
    "bench:competitors:smoke": "bun bench/generation-matrix.ts --smoke",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "artifact:web": "bun scripts/check-artifact.ts --web",
    "perf:check": "bun bench/check.ts"
  },
  "devDependencies": {
    "@anizoptera/publish-clean": "^0.9.1",
    "@arethetypeswrong/cli": "^0.18.5",
    "@kripod/uuidv7": "^0.3.4",
    "@lukeed/uuid": "2.0.1",
    "@microsoft/api-extractor": "7.59.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rspack/core": "2.2.3",
    "@smithy/uuid": "1.4.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "crypto-randomuuid": "1.0.0",
    "esbuild": "0.28.2",
    "fastv7": "^1.0.2",
    "git-cliff": "^2.13.1",
    "mdast-util-from-markdown": "^2.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "parcel": "2.16.4",
    "playwright": "^1.63.0",
    "pnpm": "^11.21.0",
    "publint": "^0.3.23",
    "rollup": "4.63.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "typescript-floor": "npm:typescript@5.7.3",
    "uniku": "0.6.0",
    "uuid": "^14.0.2",
    "uuid-random": "1.3.2",
    "uuidv7": "^1.2.1",
    "uuidv7-js": "^2.0.0",
    "vitest": "^4.1.11",
    "webpack": "5.110.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publish-clean": {
    "validateArtifact": [
      "bun",
      "scripts/check-artifact.ts"
    ]
  }
}
