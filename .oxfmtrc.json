{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Preserve authored prose line breaks; printWidth still governs code.
  "proseWrap": "preserve",
  // Art excludes Markdown formatting: table padding ignores printWidth. Do not re-enable it
  // without approval. This also leaves other Markdown normalization to authors.
  // Include the formatter's Markdown/MDX filenames as well as extensions.
  "ignorePatterns": [
    "**/*.{md,livemd,markdown,mdown,mdwn,mdx,mkd,mkdn,mkdown,ronn,scd,workbook}",
    "**/README",
    "**/contents.lr"
  ]
}
