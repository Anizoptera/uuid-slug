{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Prose is excluded below; printWidth governs code only.
  "proseWrap": "preserve",
  // Do not format prose, including tables or embedded examples. Keep filename-based
  // Markdown detection excluded too; proseWrap alone does not disable formatting.
  "ignorePatterns": [
    "**/*.{md,livemd,markdown,mdown,mdwn,mdx,mkd,mkdn,mkdown,ronn,scd,workbook}",
    "**/*.{txt,text,rst,adoc,asciidoc}",
    "**/README",
    "**/{LICENSE,LICENCE,COPYING,NOTICE,AUTHORS,CONTRIBUTORS,CHANGELOG}",
    "**/contents.lr"
  ]
}
